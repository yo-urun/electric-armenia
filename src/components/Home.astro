---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui, locales, localeShort, localePath, localeName, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const serviceIcons = [
  "i-tabler-cable",
  "i-tabler-tool",
  "i-tabler-home-automation",
  "i-tabler-shield-check",
  "i-tabler-bolt",
  "i-tabler-leaf",
];
const services = t.services.items.map((item, i) => ({ ...item, icon: serviceIcons[i] }));

const smartIcons = ["i-tabler-adjustments", "i-tabler-shield-lock", "i-tabler-leaf"];
const smartItems = t.smart.items.map((item, i) => ({ ...item, icon: smartIcons[i] }));
const tileIcons = [
  "i-tabler-bulb",
  "i-tabler-thermometer",
  "i-tabler-door-enter",
  "i-tabler-camera",
  "i-tabler-stack-2",
  "i-tabler-bolt",
];

const aboutIcons = ["i-tabler-award", "i-tabler-clock-check", "i-tabler-shield-check"];
const aboutItems = t.about.items.map((item, i) => ({ ...item, icon: aboutIcons[i] }));
---

<BaseLayout
  lang={lang}
  title={`${t.brand} — ${t.hero.b} ${t.hero.c}`}
  description={t.hero.lead}
>
  <!-- Header -->
  <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
    <div class="section-x flex h-16 items-center justify-between gap-4 sm:h-[72px]">
      <a href={localePath[lang]} class="flex items-center gap-2.5 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-cyan-400 text-white shadow-lg shadow-blue-500/30">
          <span class="i-tabler-bolt h-5 w-5"></span>
        </span>
        <span class="hidden text-[15px] font-semibold tracking-tight text-white sm:inline sm:text-base">{t.brand}</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label={t.nav.services}>
        <a href="#services" class="rounded-lg px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:text-white">{t.nav.services}</a>
        <a href="#smart-home" class="rounded-lg px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:text-white">{t.nav.smart}</a>
        <a href="#about" class="rounded-lg px-3 py-2 text-sm font-medium text-white/70 transition-colors hover:text-white">{t.nav.about}</a>
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Language switcher -->
        <div class="flex items-center rounded-full bg-white/10 p-1 ring-1 ring-white/15 backdrop-blur" role="group" aria-label="Language">
          {
            locales.map((l) => (
              <a
                href={localePath[l]}
                hreflang={l}
                title={localeName[l]}
                aria-current={l === lang ? "true" : undefined}
                class:list={[
                  "rounded-full px-2.5 py-1 text-[11px] font-semibold tracking-wide transition-colors sm:px-3 sm:text-xs",
                  l === lang ? "bg-white text-slate-900" : "text-white/65 hover:text-white",
                ]}
              >
                {localeShort[l]}
              </a>
            ))
          }
        </div>

        <a
          href="#contact"
          class="hidden min-h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-medium text-white shadow-lg shadow-blue-600/25 transition duration-200 ease-out hover:bg-blue-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 md:inline-flex"
        >
          {t.nav.contact}
        </a>

        <button
          id="menuBtn"
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-white transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 md:hidden"
          aria-label={t.nav.contact}
          aria-controls="mobileMenu"
          aria-expanded="false"
        >
          <span id="menuIconOpen" class="i-tabler-menu-2 h-6 w-6"></span>
          <span id="menuIconClose" class="i-tabler-x hidden h-6 w-6"></span>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobileMenu" class="hidden border-t border-white/10 bg-slate-950/95 backdrop-blur-xl md:hidden">
      <nav class="section-x flex flex-col py-3">
        <a href="#services" class="flex min-h-12 items-center rounded-xl px-3 text-base font-medium text-white/80 transition-colors hover:bg-white/5 hover:text-white">{t.nav.services}</a>
        <a href="#smart-home" class="flex min-h-12 items-center rounded-xl px-3 text-base font-medium text-white/80 transition-colors hover:bg-white/5 hover:text-white">{t.nav.smart}</a>
        <a href="#about" class="flex min-h-12 items-center rounded-xl px-3 text-base font-medium text-white/80 transition-colors hover:bg-white/5 hover:text-white">{t.nav.about}</a>
        <a href="#contact" class="btn-primary mt-2 mb-1">{t.nav.contact}</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-slate-950 text-white">
      <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-blue-600/25 blur-3xl"></div>
      <div class="pointer-events-none absolute inset-0 opacity-[0.18]" style="background-image:linear-gradient(to right, rgba(255,255,255,.5) 1px, transparent 1px),linear-gradient(to bottom, rgba(255,255,255,.5) 1px, transparent 1px);background-size:56px 56px;mask-image:radial-gradient(70% 60% at 50% 0%, black, transparent)"></div>

      <div class="section-x relative py-16 sm:py-20 lg:py-28">
        <div class="max-w-3xl">
          <span class="pill fade-up border-blue-400/30 bg-blue-500/10 text-blue-200">
            <span class="i-tabler-map-pin h-4 w-4"></span>
            {t.badge}
          </span>

          <h1 class="fade-up mt-5 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl" style="animation-delay:.05s">
            {t.hero.a} <span class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">{t.hero.b}</span> {t.hero.c}
          </h1>

          <p class="fade-up mt-5 max-w-2xl text-base text-slate-300 sm:mt-6 sm:text-lg" style="animation-delay:.1s">
            {t.hero.lead}
          </p>

          <div class="fade-up mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:gap-4" style="animation-delay:.15s">
            <a href="#contact" class="btn-primary">
              {t.cta.primary}
              <span class="i-tabler-arrow-right h-5 w-5"></span>
            </a>
            <a href="#services" class="btn-glass">
              {t.cta.secondary}
            </a>
          </div>

          <ul class="fade-up mt-6 flex flex-wrap gap-2" style="animation-delay:.2s">
            {
              t.chips.map((chip) => (
                <li class="rounded-full bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-300 ring-1 ring-white/10 sm:text-sm">
                  {chip}
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="mt-12 grid max-w-2xl grid-cols-3 gap-2.5 sm:mt-16 sm:gap-5">
          {
            t.stats.map((s, i) => (
              <div class="fade-up min-w-0 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10 backdrop-blur sm:p-5" style={`animation-delay:${0.25 + i * 0.05}s`}>
                <dt class="text-xl font-bold text-white sm:text-3xl">{s.value}</dt>
                <dd class="mt-1 text-[11px] leading-snug text-slate-400 sm:text-sm">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="scroll-mt-24 bg-slate-50 py-16 sm:py-20 lg:py-24">
      <div class="section-x">
        <div class="max-w-2xl">
          <span class="eyebrow text-blue-600">
            <span class="h-1 w-6 rounded-full bg-blue-600"></span>
            {t.nav.services}
          </span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{t.services.title}</h2>
          <p class="mt-3 text-base text-slate-600 sm:text-lg">{t.services.lead}</p>
        </div>

        <div class="mt-10 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
          {
            services.map((s) => (
              <article class="card card-hover group min-w-0">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-blue-100 transition-colors group-hover:bg-blue-600 group-hover:text-white group-hover:ring-blue-600">
                  <span class={`${s.icon} h-6 w-6`}></span>
                </span>
                <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Smart home -->
    <section id="smart-home" class="scroll-mt-24 bg-white py-16 sm:py-20 lg:py-24">
      <div class="section-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div>
          <span class="eyebrow text-blue-600">
            <span class="h-1 w-6 rounded-full bg-blue-600"></span>
            {t.nav.smart}
          </span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{t.smart.title}</h2>
          <p class="mt-3 text-base text-slate-600 sm:text-lg">{t.smart.lead}</p>

          <ul class="mt-9 space-y-6">
            {
              smartItems.map((item) => (
                <li class="flex gap-4">
                  <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-slate-900 text-white">
                    <span class={`${item.icon} h-6 w-6`}></span>
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold text-slate-900">{item.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="relative">
          <div class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-blue-500/20 to-cyan-400/10 blur-2xl"></div>
          <div class="relative rounded-[1.75rem] bg-slate-950 p-3 shadow-soft ring-1 ring-white/10">
            <div class="rounded-[1.25rem] bg-slate-900 p-4 sm:p-5">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-white">{t.smart.title}</span>
                <span class="flex items-center gap-2 text-xs text-emerald-400">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  online
                </span>
              </div>
              <div class="grid grid-cols-2 gap-3">
                {
                  t.smart.tiles.map((tile, i) => (
                    <div class="rounded-xl bg-white/5 p-4 ring-1 ring-white/10 transition-colors hover:bg-white/10">
                      <span class={`${tileIcons[i]} h-6 w-6 text-blue-300`}></span>
                      <div class="mt-3 text-sm font-medium text-white">{tile}</div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="scroll-mt-24 bg-slate-50 py-16 sm:py-20 lg:py-24">
      <div class="section-x">
        <div class="mx-auto max-w-2xl text-center">
          <span class="eyebrow justify-center text-blue-600">
            <span class="h-1 w-6 rounded-full bg-blue-600"></span>
            {t.nav.about}
          </span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{t.about.title}</h2>
          <p class="mt-3 text-base text-slate-600 sm:text-lg">{t.about.lead}</p>
        </div>

        <div class="mx-auto mt-10 grid max-w-4xl gap-5 sm:mt-12 sm:grid-cols-3">
          {
            aboutItems.map((c) => (
              <div class="card card-hover min-w-0 text-center">
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-blue-100">
                  <span class={`${c.icon} h-6 w-6`}></span>
                </span>
                <h3 class="mt-4 text-lg font-semibold text-slate-900">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="scroll-mt-24 bg-slate-950 py-16 text-white sm:py-20 lg:py-24">
      <div class="section-x">
        <div class="relative mx-auto max-w-3xl overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-blue-600/20 via-slate-900 to-slate-900 p-8 ring-1 ring-white/10 sm:p-12">
          <div class="pointer-events-none absolute -top-24 right-0 h-64 w-64 rounded-full bg-blue-500/25 blur-3xl"></div>
          <div class="relative text-center">
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.contact.title}</h2>
            <p class="mx-auto mt-3 max-w-xl text-base text-slate-300 sm:text-lg">{t.contact.lead}</p>
            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
              <a href="tel:+37400000000" class="btn bg-white text-slate-900 shadow-lg shadow-black/20 hover:bg-slate-100 focus-visible:ring-white">
                <span class="i-tabler-phone h-5 w-5"></span>
                {t.contact.call}
              </a>
              <a href="mailto:info@electricarmenia.am" class="btn-glass">
                <span class="i-tabler-mail h-5 w-5"></span>
                {t.contact.email}
              </a>
            </div>
            <p class="mt-5 text-xs text-slate-400">{t.contact.note}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/10 bg-slate-950 py-10 text-white">
    <div class="section-x flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-cyan-400 text-white">
          <span class="i-tabler-bolt h-5 w-5"></span>
        </span>
        <div>
          <div class="text-sm font-semibold">{t.brand}</div>
          <div class="text-xs text-slate-400">{t.footer.tag}</div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center rounded-full bg-white/10 p-1 ring-1 ring-white/15">
          {
            locales.map((l) => (
              <a
                href={localePath[l]}
                hreflang={l}
                class:list={[
                  "rounded-full px-3 py-1 text-xs font-semibold transition-colors",
                  l === lang ? "bg-white text-slate-900" : "text-white/65 hover:text-white",
                ]}
              >
                {localeShort[l]}
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="section-x mt-8 border-t border-white/10 pt-6">
      <p class="text-xs text-slate-500">© {new Date().getFullYear()} {t.brand}. {t.footer.rights}</p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById("menuBtn");
    const menu = document.getElementById("mobileMenu");
    const iconOpen = document.getElementById("menuIconOpen");
    const iconClose = document.getElementById("menuIconClose");

    if (btn && menu) {
      const setOpen = (open: boolean) => {
        menu.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
      };

      btn.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    }
  </script>

  <style>
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .fade-up {
      animation: fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .fade-up {
        animation: none;
      }
    }
  </style>
</BaseLayout>
