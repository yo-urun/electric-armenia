---
import BaseLayout from "../layouts/BaseLayout.astro";
import LangSwitch from "./LangSwitch.astro";
import { ui, localePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const nav = [
  { href: "#services", label: t.nav.services },
  { href: "#smart", label: t.nav.smart },
  { href: "#standards", label: t.nav.standards },
];

const tel = "+37400000000";
const circuits = t.hero.diagram.circuits;
const busTop = 70;
const busStep = 38;
const busBottom = busTop + busStep * (circuits.length - 1);
const yAt = (i: number) => busTop + busStep * i;
---

<BaseLayout lang={lang} title={`${t.brand} — ${t.hero.headline}`} description={t.hero.lead}>
  <!-- Header: solid surface, hairline rule. No glass. -->
  <header class="sticky top-0 z-50 border-b border-line bg-ground">
    <div class="container flex h-16 items-center justify-between gap-4">
      <a
        href={localePath[lang]}
        class="flex items-center gap-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-signal" aria-hidden="true">
          <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="currentColor"></path>
        </svg>
        <span class="hidden text-base font-bold tracking-tight sm:inline">{t.brand}</span>
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label={t.nav.services}>
        {
          nav.map((item) => (
            <a href={item.href} class="link-ink text-sm no-underline hover:underline">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <LangSwitch lang={lang} />

        <a href="#contact" class="btn-primary hidden md:inline-flex">{t.hero.ctaPrimary}</a>

        <button
          id="menuBtn"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-sm border border-line text-ink transition-colors hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink md:hidden"
          aria-label={t.nav.contact}
          aria-controls="mobileMenu"
          aria-expanded="false"
        >
          <svg id="menuIconOpen" viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
          </svg>
          <svg id="menuIconClose" viewBox="0 0 24 24" class="hidden h-5 w-5" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobileMenu" class="hidden border-t border-line bg-surface md:hidden">
      <nav class="container flex flex-col py-2" aria-label={t.nav.contact}>
        {
          nav.map((item) => (
            <a href={item.href} class="flex min-h-12 items-center px-1 text-base text-ink transition-colors hover:text-signal">
              {item.label}
            </a>
          ))
        }
        <a href="#contact" class="btn-primary my-2">{t.hero.ctaPrimary}</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero: argument + single-line diagram -->
    <section class="bg-ground">
      <div class="container grid items-start gap-12 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          <h1 class="rise text-[clamp(2rem,5vw,3.25rem)] font-extrabold leading-[1.08] tracking-tight">
            {t.hero.headline}
          </h1>
          <p class="rise mt-5 max-w-xl text-lg text-muted" style="animation-delay:.08s">
            {t.hero.lead}
          </p>

          <div class="rise mt-6 flex items-center gap-2 text-sm text-muted" style="animation-delay:.12s">
            <span class="h-1.5 w-1.5 rounded-full bg-signal"></span>
            {t.hero.region}
          </div>

          <div class="rise mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" style="animation-delay:.16s">
            <a href={`tel:${tel}`} class="btn-primary">
              <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                <path d="M5 4h4l2 5-2 1a12 12 0 0 0 5 5l1-2 5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
              </svg>
              {t.hero.ctaPrimary}
            </a>
            <a href="#services" class="link-ink text-sm">{t.hero.ctaSecondary}</a>
          </div>
        </div>

        <!-- Signature: single-line diagram, drawn once on load -->
        <figure class="rounded-md border border-line bg-surface p-4 sm:p-6">
          <svg viewBox="0 0 520 290" class="h-auto w-full" role="img" aria-label={t.schedule.title}>
            <!-- source -->
            <rect x="6" y="128" width="76" height="44" rx="4" fill="none" stroke="#15181C" stroke-width="1.5" class="dim" />
            <text x="44" y="155" text-anchor="middle" font-size="13" fill="#15181C" class="dim">{t.hero.diagram.source}</text>

            <!-- feed: source -> meter (live) -->
            <path d="M82 150 H150" fill="none" stroke="#E9A200" stroke-width="2.5" pathLength="1" class="draw" style="animation-delay:.1s" />

            <!-- meter -->
            <rect x="150" y="126" width="72" height="48" rx="4" fill="none" stroke="#15181C" stroke-width="1.5" class="dim" />
            <text x="186" y="155" text-anchor="middle" font-size="12" fill="#15181C" class="dim">{t.hero.diagram.meter}</text>

            <!-- meter -> panel bus (live) -->
            <path d="M222 150 H262" fill="none" stroke="#E9A200" stroke-width="2.5" pathLength="1" class="draw" style="animation-delay:.25s" />

            <!-- panel bus -->
            <path d={`M262 ${busTop} V${busBottom}`} fill="none" stroke="#15181C" stroke-width="2.5" pathLength="1" class="draw" style="animation-delay:.4s" />
            <text x="262" y={busTop - 16} text-anchor="middle" font-size="12" font-weight="600" fill="#15181C" class="dim">{t.hero.diagram.panel}</text>

            <!-- branches -->
            {
              circuits.map((c, i) => (
                <>
                  <path
                    d={`M262 ${yAt(i)} H330`}
                    fill="none"
                    stroke="#15181C"
                    stroke-width="1.5"
                    pathLength="1"
                    class="draw"
                    style={`animation-delay:${0.55 + i * 0.12}s`}
                  />
                  <circle cx="262" cy={yAt(i)} r="3.5" fill="#E9A200" class="dim" />
                  <circle cx="330" cy={yAt(i)} r="2.5" fill="#15181C" class="dim" />
                  <text x="344" y={yAt(i) + 4} font-size="13" fill="#15181C" class="dim">
                    {c}
                  </text>
                </>
              ))
            }
          </svg>
        </figure>
      </div>
    </section>

    <!-- Service schedule: labeled rows, not cards -->
    <section id="services" class="border-y border-line bg-surface">
      <div class="container py-14 sm:py-20">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.schedule.title}</h2>
          <p class="mt-3 text-muted">{t.schedule.lead}</p>
        </div>

        <div class="mt-8 sm:mt-10">
          <div class="rule grid grid-cols-1 gap-x-10 py-3 text-xs font-medium text-muted sm:grid-cols-[1fr_1.5fr]">
            <span>{t.schedule.colService}</span>
            <span class="hidden sm:block">{t.schedule.colScope}</span>
          </div>
          {
            t.schedule.items.map((item) => (
              <div class="rule grid grid-cols-1 gap-x-10 gap-y-1 py-5 transition-colors hover:bg-ground sm:grid-cols-[1fr_1.5fr]">
                <span class="font-semibold text-ink">{item.name}</span>
                <span class="text-muted">{item.scope}</span>
              </div>
            ))
          }
          <div class="rule"></div>
        </div>
      </div>
    </section>

    <!-- Smart home -->
    <section id="smart" class="bg-ground">
      <div class="container grid gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.smart.title}</h2>
          <p class="mt-3 max-w-lg text-muted">{t.smart.lead}</p>
        </div>

        <div class="self-start overflow-hidden rounded-md border border-line bg-surface">
          {
            t.smart.items.map((item, i) => (
              <div class:list={["flex items-center gap-3 px-5 py-4", i > 0 && "border-t border-line"]}>
                <span class="h-1.5 w-1.5 flex-none rounded-full bg-signal"></span>
                <span class="text-ink">{item}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Standards -->
    <section id="standards" class="border-y border-line bg-surface">
      <div class="container py-14 sm:py-20">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.standards.title}</h2>
          <p class="mt-3 text-muted">{t.standards.lead}</p>
        </div>

        <div class="mt-8 grid gap-x-10 sm:mt-10 sm:grid-cols-2">
          {
            t.standards.items.map((item) => (
              <div class="rule flex items-start gap-3 py-4">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-signal"></span>
                <span class="text-ink">{item}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="bg-ground">
      <div class="container py-14 sm:py-20">
        <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
          <div>
            <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.contact.title}</h2>
            <p class="mt-3 max-w-xl text-muted">{t.contact.lead}</p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href={`tel:${tel}`} class="btn-primary">{t.contact.callLabel}</a>
              <a href={`mailto:${t.contact.email}`} class="btn-outline">{t.contact.emailLabel}</a>
            </div>
            <p class="mt-4 text-xs text-muted">{t.contact.note}</p>
          </div>

          <div class="self-start">
            <div class="rule flex items-baseline justify-between gap-4 py-3">
              <span class="text-xs font-medium text-muted">{t.hero.ctaPrimary}</span>
              <a href={`tel:${tel}`} class="font-mono text-sm text-ink hover:text-signal">{t.contact.phoneLabel}</a>
            </div>
            <div class="rule flex items-baseline justify-between gap-4 py-3">
              <span class="text-xs font-medium text-muted">{t.contact.emailLabel}</span>
              <a href={`mailto:${t.contact.email}`} class="font-mono text-sm text-ink hover:text-signal">{t.contact.email}</a>
            </div>
            <div class="rule"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-white">
    <div class="container flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-signal" aria-hidden="true">
          <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="currentColor"></path>
        </svg>
        <div>
          <div class="text-sm font-semibold">{t.brand}</div>
          <div class="text-xs text-white/55">{t.footer.tag}</div>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <LangSwitch lang={lang} />
      </div>
    </div>
    <div class="container border-t border-white/10 py-5">
      <p class="text-xs text-white/55">© {new Date().getFullYear()} {t.brand}. {t.footer.rights}</p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById("menuBtn");
    const menu = document.getElementById("mobileMenu");
    const iconOpen = document.getElementById("menuIconOpen");
    const iconClose = document.getElementById("menuIconClose");

    if (btn && menu) {
      const setOpen = (open: boolean) => {
        menu.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        iconOpen?.classList.toggle("hidden", open);
        iconClose?.classList.toggle("hidden", !open);
      };
      btn.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    }
  </script>

  <style>
    /* The diagram draws itself once. Nothing else animates. */
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    .draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .dim {
      opacity: 0;
      animation: fade 0.5s ease-out forwards;
      animation-delay: 0.5s;
    }
    @keyframes fade {
      to {
        opacity: 1;
      }
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .rise {
      animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .draw,
      .dim,
      .rise {
        animation: none;
        opacity: 1;
        stroke-dashoffset: 0;
      }
    }
  </style>
</BaseLayout>
