---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:h-16 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-xs font-bold text-white sm:h-9 sm:w-9 sm:text-sm">EH</div>
        <span class="text-sm font-semibold sm:text-base lg:text-lg">Էլեկտրիկ Հայաստան</span>
      </a>
      <nav class="hidden items-center gap-6 md:flex lg:gap-8">
        <a href="#services" class="text-sm font-medium text-neutral-700 transition-colors hover:text-blue-600">Ծառայություններ</a>
        <a href="#smart-home" class="text-sm font-medium text-neutral-700 transition-colors hover:text-blue-600">Խելացի Տներ</a>
        <a href="#about" class="text-sm font-medium text-neutral-700 transition-colors hover:text-blue-600">Մեր մասին</a>
        <a href="#contact" class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 active:scale-[0.995]">Կապ</a>
      </nav>
      <button id="menuBtn" class="inline-flex items-center justify-center rounded-lg p-2 text-neutral-700 transition-colors hover:bg-neutral-100 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 md:hidden" aria-label="Բացեք ընտրացանկը" aria-expanded="false" aria-controls="mobileMenu">
        <div class="i-tabler-menu h-5 w-5"></div>
      </button>
    </div>
  </header>

  <div id="mobileMenu" class="md:hidden fixed inset-x-0 top-14 z-20 hidden border-b border-neutral-200 bg-white shadow-lg">
    <nav class="flex flex-col px-4 py-2">
      <a href="#services" class="min-h-[44px] flex items-center rounded-lg px-2 text-base font-medium text-neutral-900 hover:bg-neutral-100">Ծառայություններ</a>
      <a href="#smart-home" class="min-h-[44px] flex items-center rounded-lg px-2 text-base font-medium text-neutral-900 hover:bg-neutral-100">Խելացի Տներ</a>
      <a href="#about" class="min-h-[44px] flex items-center rounded-lg px-2 text-base font-medium text-neutral-900 hover:bg-neutral-100">Մեր մասին</a>
      <a href="#contact" class="mt-2 mb-1 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-base font-medium text-white hover:bg-blue-700 active:scale-[0.995]">Կապ</a>
    </nav>
  </div>

  <main>
    <section class="relative overflow-hidden bg-gradient-to-b from-white to-neutral-50">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
          <div>
            <h1 class="text-balance text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl lg:text-5xl">
              Էլեկտրիկ ծառայություններ և <span class="text-blue-600">Խելացի Տներ</span> Հայաստանում
            </h1>
            <p class="mt-4 max-w-prose text-pretty text-base text-neutral-600 sm:mt-5 sm:text-lg">
              Պրոֆեսիոնալ էլեկտրամոնտաժ, սպասարկում և խելացի տան լուծումներ։ Անվտանգություն, հուսալիություն և ժամանակին իրականացում։
            </p>
            <div class="mt-6 flex flex-wrap gap-3 sm:mt-7 sm:gap-4">
              <a href="#contact" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 active:scale-[0.995] sm:text-base">
                Պատվիրել ծառայություն
                <div class="i-tabler-arrow-right h-5 w-5"></div>
              </a>
              <a href="#services" class="inline-flex min-h-[44px] items-center rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 shadow-sm ring-1 ring-neutral-200 transition-colors hover:bg-neutral-50 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 active:scale-[0.995] sm:text-base">
                Ծառայություններ
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <div class="text-center">
        <h2 class="text-balance text-xl font-bold tracking-tight sm:text-2xl md:text-3xl">Ծառայությունների շրջանակ</h2>
        <p class="mx-auto mt-3 max-w-2xl text-pretty text-base text-neutral-600 sm:mt-4">Բազմամասնագիտական էլեկտրական լուծումներ</p>
      </div>
      <div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        <article class="flex flex-col gap-2 rounded-xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
          <h3 class="text-base font-semibold sm:text-lg">Էլեկտրամոնտաժ</h3>
          <p class="text-sm leading-relaxed text-neutral-600">Նորակառույցների և վերանորոգումների էլեկտրամոնտաժ</p>
        </article>
        <article class="flex flex-col gap-2 rounded-xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
          <h3 class="text-base font-semibold sm:text-lg">Սպասարկում և վերանորոգում</h3>
          <p class="text-sm leading-relaxed text-neutral-600">Ախտորոշում, վերանորոգում, սպասարկում</p>
        </article>
        <article class="flex flex-col gap-2 rounded-xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
          <h3 class="text-base font-semibold sm:text-lg">Խելացի Տներ</h3>
          <p class="text-sm leading-relaxed text-neutral-600">Ավտոմատացում, անվտանգություն, էներգիայի կառավարում</p>
        </article>
      </div>
    </section>

    <section id="smart-home" class="bg-white py-10 sm:py-14 lg:py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-10">
          <div>
            <h2 class="text-balance text-xl font-bold tracking-tight sm:text-2xl md:text-3xl">Խելացի Տներ</h2>
            <p class="mt-3 text-pretty text-base text-neutral-600">Հարմարավետություն, անվտանգություն, էներգաարդյունավետություն</p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-balance text-xl font-bold tracking-tight sm:text-2xl md:text-3xl">Մեր մասին</h2>
        <p class="mt-3 text-pretty text-base text-neutral-600">Պրոֆեսիոնալ մոտեցում, որակ, հուսալիություն</p>
      </div>
    </section>

    <section id="contact" class="bg-neutral-900 py-10 text-white sm:py-14">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-balance text-xl font-bold tracking-tight sm:text-2xl md:text-3xl">Պատվիրեք ծառայություն</h2>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            <a href="tel:+37400000000" class="inline-flex min-h-[44px] items-center rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 hover:bg-neutral-100">Զանգահարել</a>
            <a href="mailto:info@electricarmenia.am" class="inline-flex min-h-[44px] items-center rounded-lg border border-white/20 bg-white/10 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/20">Էլ. նամակ</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-neutral-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="text-center text-sm text-neutral-600">
        © 2026 Էլեկտրիկ Հայաստան. Բոլոր իրավունքները պաշտպանված են։
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('menuBtn');
    const menu = document.getElementById('mobileMenu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
      menu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</BaseLayout>