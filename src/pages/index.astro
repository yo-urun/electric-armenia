---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:h-16 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-xs font-bold text-white sm:h-9 sm:w-9 sm:text-sm">EH</div>
        <span class="text-sm font-semibold sm:text-base lg:text-lg">Էլեկտրիկ Հայաստան</span>
      </a>
      <nav class="hidden items-center gap-6 md:flex">
        <a href="#services" class="text-sm font-medium text-neutral-700 hover:text-blue-600">Ծառայություններ</a>
        <a href="#smart-home" class="text-sm font-medium text-neutral-700 hover:text-blue-600">Խելացի Տներ</a>
        <a href="#about" class="text-sm font-medium text-neutral-700 hover:text-blue-600">Մեր մասին</a>
        <a href="#contact" class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Կապ</a>
      </nav>
      <button id="menuBtn" class="inline-flex items-center justify-center rounded-lg p-2 md:hidden" aria-label="Menu" aria-expanded="false">
        <div class="i-tabler-menu h-5 w-5"></div>
      </button>
    </div>
  </header>
  <div id="mobileMenu" class="md:hidden fixed inset-x-0 top-14 z-20 hidden border-b border-neutral-200 bg-white">
    <nav class="flex flex-col px-4 py-2">
      <a href="#services" class="min-h-[44px] flex items-center px-2">Ծառայություններ</a>
      <a href="#smart-home" class="min-h-[44px] flex items-center px-2">Խելացի Տներ</a>
      <a href="#about" class="min-h-[44px] flex items-center px-2">Մեր մասին</a>
      <a href="#contact" class="min-h-[44px] flex items-center justify-center rounded-lg bg-blue-600 px-4 text-white my-1">Կապ</a>
    </nav>
  </div>
  <main>
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-bold sm:text-3xl md:text-4xl lg:text-5xl">Էլեկտրիկ ծառայություններ և Խելացի Տներ Հայաստանում</h1>
      <p class="mt-4 text-neutral-600">Պրոֆեսիոնալ էլեկտրամոնտաժ, սպասարկում և խելացի տան լուծումներ</p>
    </section>
    <section id="services" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold sm:text-2xl">Ծառայություններ</h2>
    </section>
    <section id="smart-home" class="bg-white py-8 sm:py-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold sm:text-2xl">Խելացի Տներ</h2>
      </div>
    </section>
    <section id="about" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold sm:text-2xl">Մեր մասին</h2>
    </section>
    <section id="contact" class="bg-neutral-900 py-8 text-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold sm:text-2xl">Կապ</h2>
      </div>
    </section>
  </main>
  <script>
    const b=document.getElementById('menuBtn'),m=document.getElementById('mobileMenu');
    if(b&&m){b.onclick=()=>{const o=m.classList.toggle('hidden')===false;b.setAttribute('aria-expanded',String(o));};m.querySelectorAll('a').forEach(a=>a.onclick=()=>{m.classList.add('hidden');b.setAttribute('aria-expanded','false');});}
  </script>
</BaseLayout>