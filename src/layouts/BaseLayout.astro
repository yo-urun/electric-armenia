---
import "@unocss/reset/tailwind.css";
import { locales, localePath, defaultLang, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  title: string;
  description: string;
}

const { lang = defaultLang, title, description } = Astro.props;
const site = Astro.site ?? new URL("https://electric-armenia.pages.dev");
const canonical = new URL(localePath[lang], site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F4F2" />
    <link rel="canonical" href={canonical} />

    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath[l], site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath[defaultLang], site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;500;600;700;800&family=Noto+Sans+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="min-h-screen bg-ground font-sans text-ink antialiased">
    <slot />

    <style is:global>
      html,
      body {
        overflow-x: clip;
      }
      :where(h1, h2, h3, h4, p, li, dt, dd, a, span, strong) {
        overflow-wrap: break-word;
      }
      ::selection {
        background: #e9a200;
        color: #15181c;
      }
      :target {
        scroll-margin-top: 5.5rem;
      }
    </style>
  </body>
</html>
